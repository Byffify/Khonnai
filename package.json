{
  "name": "micro-erp-inventory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-landing.mjs && vite",
    "build": "node scripts/build-landing.mjs && tsc -b && vite build",
    "landing:build": "node scripts/build-landing.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "ux:skills": "ux-ui-agent-skills list",
    "theme:build": "node scripts/build-theme.mjs",
    "theme:check": "node scripts/build-theme.mjs --check",
    "auth:prototype": "node .scratch/auth-prototype/server.mjs",
    "auth:check": "node scripts/check-auth-staging.mjs",
    "auth:db:check": "node scripts/check-staging-database.mjs",
    "auth:db:test:foundation": "node scripts/test-staging-foundation.mjs --installed",
    "auth:db:migrate": "node scripts/migrate-auth-staging.mjs",
    "auth:runtime:prepare": "node scripts/prepare-auth-runtime.mjs",
    "auth:server": "node server/main.ts",
    "auth:dev": "node scripts/dev-auth-staging.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "lenis": "^1.3.27",
    "motion": "^14.3.0",
    "pg": "8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ux-ui-agent-skills": "^2.9.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "sharp": "^0.35.5",
    "supabase": "2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
